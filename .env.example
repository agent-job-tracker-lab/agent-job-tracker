# Local PostgreSQL. Do not reuse these credentials outside local development.
POSTGRES_DB=agent_job_tracker
POSTGRES_USER=agent_job_tracker
POSTGRES_PASSWORD=local_development_only
DATABASE_URL=postgresql://agent_job_tracker:local_development_only@localhost:5432/agent_job_tracker?schema=public

# Generate a unique value for any shared or production environment.
BETTER_AUTH_SECRET=local-development-secret-change-before-sharing-32chars
BETTER_AUTH_URL=http://localhost:3000
# Better Auth disables rate limiting in development by default. Enable it when testing login throttling.
AUTH_RATE_LIMIT_ENABLED=false

# Initial user bootstrap values. Replace locally; never commit real credentials.
BOOTSTRAP_USER_EMAIL=developer@example.test
BOOTSTRAP_USER_NAME=Local Developer
BOOTSTRAP_USER_PASSWORD=replace-with-a-local-password
